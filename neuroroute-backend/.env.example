# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file to Git.

# Port the Express server runs on
PORT=5000

# MongoDB connection string.
# Local MongoDB:  mongodb://127.0.0.1:27017/neuroroute
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster-url>/neuroroute
MONGODB_URI=mongodb+srv://siddhiagnihotri02_db_user:oD7DElmIqtOH6CKt@neuroroute.88yq34i.mongodb.net/?appName=NeuroRoute

# Secret used to sign JWT auth tokens - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_string

# Routing engine (public OSRM demo server - fine for development/testing only)
OSRM_BASE_URL=https://router.project-osrm.org

# Overpass API (OpenStreetMap spatial queries - parks, libraries, cafes, etc.)
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Nominatim (OpenStreetMap geocoding - converts "Bandra, Mumbai" into lat/lng)
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
